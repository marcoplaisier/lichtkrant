spi:
  device: "/dev/spidev0.0"
  # The Lichtkrant 2.1 spec requires 125 kHz so the PIC can keep up.
  speed_hz: 125000
  mode: 0

gpio:
  # On the Lichtkrant 2.1 board, REQUEST is wired to BCM4 (header pin 7).
  request_pin: 4
  # Per the spec the REQUEST line is idle HIGH and the PIC pulls it LOW
  # to request the next text, so it is active-low.
  request_active_high: false

wifi:
  ssid: "Lichtkrant"
  password: "lichtkrant"

web:
  host: "0.0.0.0"
  port: 8080
