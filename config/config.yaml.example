spi:
  device: "/dev/spidev0.0"
  speed_hz: 500000
  mode: 0

gpio:
  request_pin: 17
  # Per the Lichtkrant 2.1 spec the REQUEST line is idle HIGH and the PIC
  # pulls it LOW to request the next text, so it is active-low.
  request_active_high: false

wifi:
  ssid: "Lichtkrant"
  password: "lichtkrant"

web:
  host: "0.0.0.0"
  port: 8080
